# 로컬 개발: /api (vite proxy → gilmoa-dev, 쿠키·CORS 유리)
# 직접 호출: https://gilmoa-dev.gyeonseo.com/api
VITE_API_BASE_URL=/api
VITE_USE_MOCK_BRIDGE=true
# 브라우저에서 네이티브 앱처럼 웹 하단 탭바 숨김
VITE_HIDE_WEB_NAV=false
# true면 개발용 mock 로그인. 소셜 로그인 테스트 시 false
VITE_DEV_AUTH=false

# 웹 OAuth (공개 값). Secret은 백엔드만.
# 콜백: http://localhost:3000/oauth/{kakao|naver|google}/callback (vite port 3000)
VITE_KAKAO_REST_API_KEY=
VITE_NAVER_CLIENT_ID=
VITE_GOOGLE_WEB_CLIENT_ID=